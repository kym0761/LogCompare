{
  "LlmProvider": "Ollama",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=LogCompareDb;Username=postgres;Password=password"
  },
  "FileSettings": {
    "RawLogFolderPath": "C:\\docker_data\\raw_logs",
    "ProcessedLogFolderPath": "C:\\docker_data\\processed_logs",
    "ErrorLogFolderPath": "C:\\docker_data\\error_logs",
    "EnableFileArchiving": false,
    "PromptFolderPath": "Prompts"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434/v1",
    "ModelId": "gemma4:12b",
    "FunctionChoice": "Auto",
    "Temperature": 0.1,
    "MaxTokens": 4096,
    "MaxIterations": 5,
    "MinIterationTimeMs": 100,
    "WorkerDelayMs": 500,
    "NumCtx": 131072,
    "EnableLLMAnalysis": true,
    "BatchIntervalMinutes": 60,
    "RetryIntervalMinutes": 10
  },
  "Vllm": {
    "Endpoint": "http://localhost:8000/v1",
    "ModelId": "meta-llama/Meta-Llama-3-8B-Instruct",
    "ApiKey": "no-key",
    "FunctionChoice": "Auto",
    "Temperature": 0.1,
    "MaxTokens": 4096,
    "MaxIterations": 5,
    "MinIterationTimeMs": 100,
    "WorkerDelayMs": 500,
    "EnableLLMAnalysis": true,
    "BatchIntervalMinutes": 60,
    "RetryIntervalMinutes": 10
  }
}